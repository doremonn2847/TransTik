# Copy this file to .env and fill in what you need.

# --- Speech-to-text (used only for videos with no platform captions) ---
# Any OpenAI-compatible /audio/transcriptions endpoint works.
# Groq (default, cheapest): https://console.groq.com/keys
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_MODEL=whisper-large-v3-turbo
ASR_API_KEY=

# OpenAI instead:
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# ASR_API_KEY=sk-...

# --- MCP over the tunnel ---
# Secret part of the public MCP address. Leave empty to generate one in data/mcp_secret.txt.
MCP_SECRET=

# --- Behaviour ---
# Update yt-dlp each time the api container starts (1 = yes).
YTDLP_AUTO_UPDATE=1
# Videos transcribed at the same time.
WORKER_CONCURRENCY=2
# Longest video (seconds) sent to speech-to-text.
MAX_DURATION_S=1800
# Most videos taken from one profile or playlist link.
COLLECTION_LIMIT=50
